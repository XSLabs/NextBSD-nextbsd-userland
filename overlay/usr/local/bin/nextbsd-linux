#!/bin/sh
#
# nextbsd-linux(1) -- enter the /compat/linux (glibc) root as yourself.
#
# nextbsd/nextbsd#529. A thin, non-setuid wrapper around chroot(1). It drops
# into the Linux root with NO_NEW_PRIVS (the unprivileged_chroot gate), resolves
# the caller's home through the root's own NSS -- the nss_nextbsd module maps a
# directory user to /Local|/Network/Users/<name>, everyone else to /etc/passwd --
# cd's there, and execs a login shell.
#
# Root may use it unconditionally. A regular user needs the kernel gate
# compat.linux.unprivileged_chroot=1 (nextbsd-kernel PR #263); without it
# chroot(2) is EPERM. The home is read through the root so it tracks the plist.

emul=$(sysctl -n compat.linux.emul_path 2>/dev/null)
[ -d "$emul" ] || emul=/compat/linux

# Use the caller's shell when the base ships it; else the base's zsh, else dash.
shell=${SHELL:-/bin/zsh}
[ -x "$emul$shell" ] || shell=/bin/zsh
[ -x "$emul$shell" ] || shell=/bin/sh

# The inner /bin/sh resolves the home via the root's NSS (so a directory user
# lands in /Local|/Network/Users/<name>, not the host's /Users/<name>), then
# hands off to a login shell. No `--`: this chroot(1) takes
# `[-g][-G][-u][-n] newroot [command]`, and the absolute /bin/sh is not an
# option. Full paths inside: the inherited PATH is not trusted.
exec chroot -n "$emul" /bin/sh -c \
    'h=$(/usr/bin/getent passwd "$(/usr/bin/id -u)" 2>/dev/null | /usr/bin/cut -d: -f6); [ -n "$h" ] || h=/; cd "$h" 2>/dev/null || cd /; exec '"$shell"' -l'
